# Public browser token from the Mixpanel `portfolio` project.
NEXT_PUBLIC_MIXPANEL_TOKEN=your_project_token

# Server-side credentials for the Supabase writings visitor counter.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side Resend credentials for newsletter subscriptions.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Dash <dash@heywhoisdash.com>
RESEND_NEWSLETTER_SEGMENT_ID=your-segment-id
NEWSLETTER_SIGNING_SECRET=generate-a-long-random-secret
